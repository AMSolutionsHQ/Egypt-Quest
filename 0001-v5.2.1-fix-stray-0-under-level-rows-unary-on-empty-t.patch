+++ b/www/js/core/fx.js
@@ -10,7 +10,7 @@ function drawCeleb(t){if(!celeb)return;const k=(t-celeb.t0)/1800;if(k>1){celeb=n
  ctx.fillStyle="#e6b84a";ctx.beginPath();ctx.ellipse(0,0,r*.95,r*1.15,0,0,7);ctx.fill();ctx.lineWidth=4;ctx.stroke();
  ctx.fillStyle="#2f6fd8";ctx.beginPath();ctx.moveTo(-r*.7,-r*.85);ctx.lineTo(r*.7,-r*.85);ctx.lineTo(0,-r*1.7);ctx.closePath();ctx.fill();
  face(0,-r*.1,r*.85,1);ctx.save();ctx.scale(r/20,r/20);sunFace(0,-3,1);ctx.restore();ctx.restore();
- const sc=1+.08*Math.sin(t/120),fs=Math.round(Math.min(W/10,34)*sc);ctx.save();ctx.globalAlpha=Math.max(0,Math.min(1,a*1.5));ctx.textAlign="center";ctx.font="bold "+fs+"px system-ui";ctx.lineWidth=6;ctx.strokeStyle="#3a2208";ctx.fillStyle="#fff4d0";
+ const sc=1+.08*Math.sin(t/120);let fs=Math.round(Math.min(W/10,34)*sc);ctx.save();ctx.globalAlpha=Math.max(0,Math.min(1,a*1.5));ctx.textAlign="center";ctx.font="bold "+fs+"px system-ui";{const tw=ctx.measureText(celeb.txt).width,mx=W*.9;if(tw>mx){fs=Math.max(12,Math.floor(fs*mx/tw));ctx.font="bold "+fs+"px system-ui"}}ctx.lineWidth=6;ctx.strokeStyle="#3a2208";ctx.fillStyle="#fff4d0";
  ctx.strokeText(celeb.txt,W/2,cy+r*2.6);ctx.fillText(celeb.txt,W/2,cy+r*2.6);ctx.font=Math.round(fs*1.3)+"px system-ui";const st="★".repeat(celeb.stars)+"☆".repeat(3-celeb.stars);ctx.fillStyle="#ffd54a";ctx.strokeText(st,W/2,cy+r*2.6+fs*1.6);ctx.fillText(st,W/2,cy+r*2.6+fs*1.6);ctx.restore()}
 function showErr(m){let b=document.getElementById("errbar");if(!b){b=document.createElement("div");b.id="errbar";b.style.cssText="position:fixed;left:8px;right:8px;top:calc(8px + env(safe-area-inset-top,0px));z-index:50;background:#7a1f1f;color:#fff;font:12px system-ui;padding:8px 10px;border-radius:8px;word-break:break-word";document.body.appendChild(b);b.onclick=()=>{b.style.display="none"}}b.textContent="⚠ "+m+" (v"+VERSION+", tap to hide)";b.style.display="block"}
 addEventListener("error",e=>showErr((e.message||"error")+" @"+(e.lineno||"?")));addEventListener("unhandledrejection",e=>showErr(String(e.reason)));
diff --git a/www/js/core/progress.js b/www/js/core/progress.js
index 63bcbde..af1f7f7 100644
--- a/www/js/core/progress.js
+++ b/www/js/core/progress.js
@@ -30,7 +30,7 @@ function openLevels(){const ar=lang==="ar",m=$("bmenu"),id=sel.id,b=SR[id]||(SR[
  let nextI=-1;for(let i=0;i<5;i++)if(nextI<0&&Progression.levelStatus(SR,PR,id,i)==="open"&&!Progression.levelDone(SR,PR,id,i))nextI=i;
  const rows=[0,1,2,3,4].map(i=>{const st=Progression.levelStatus(SR,PR,id,i),dn=Progression.levelDone(SR,PR,id,i),cost=Progression.levelCost(i),nm=L2("Level ","المستوى ")+(i+1)+" · "+LVN[i][ar?1:0],info=lvInfo(id,i+1);
   if(st==="open"){const bt=Records.time(id,i),bts=bt?" · "+L2("best ","الأفضل ")+Math.floor(bt/60)+":"+String(bt%60).padStart(2,"0"):"";return row('data-l="'+(i+1)+'"',dn?"is-done":i===nextI?"is-next":"is-open",dn?"check":"play",nm,(cl[i]&&!b[i]?L2("passed by trial","اجتزته بالاختبار"):(info||(dn?L2("Replay to beat your best","أعد اللعب لتحسين نتيجتك"):L2("Ready to play","جاهز للعب"))))+bts,stars(b[i]))+
-   +(Progression.passageTrial(SR,PR,id,i)?row('data-t="pass" data-i="'+i+'"',"trial","sparkle",TR+": "+L2("pass level "+(i+1),"اجتز المستوى "+(i+1)),L2("Win a bonus game to mark this level passed (0★, no Ankh)","اربح لعبة إضافية لتجتاز هذا المستوى (0★ بدون عنخ)")):"")}
+   (Progression.passageTrial(SR,PR,id,i)?row('data-t="pass" data-i="'+i+'"',"trial","sparkle",TR+": "+L2("pass level "+(i+1),"اجتز المستوى "+(i+1)),L2("Win a bonus game to mark this level passed (0★, no Ankh)","اربح لعبة إضافية لتجتاز هذا المستوى (0★ بدون عنخ)")):"")}
   if(st==="afford")return row('data-u="'+i+'"',"unlock","ankh",nm,L2("Tap to unlock for ","اضغط للفتح مقابل ")+ankh(cost)+" · "+L2("you have ","لديك ")+ankh(PR.tok),'<span class="lv-cost">'+ankh(cost)+'</span>');
   if(st==="short")return row("disabled","is-lock","lock",nm,L2("Needs ","يحتاج ")+ankh(cost)+" · "+L2("you have ","لديك ")+ankh(PR.tok)+" · "+L2("earn Ankh by beating your best stars","اربح العنخ بتحسين أفضل نجومك"),'<span class="lv-cost">'+ankh(cost)+'</span>')+
    (tt===i?row('data-t="tok" data-i="'+i+'"',"trial","sparkle",TR+": +"+ankh(1),L2("Win a bonus game · "+trLeft("tok")+" left at this place","اربح لعبة إضافية · متبقٍ "+trLeft("tok")+" هنا")):"");
